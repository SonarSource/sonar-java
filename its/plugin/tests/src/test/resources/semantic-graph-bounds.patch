         TypeReference reference = currentModuleReferences.typesToResolve.pop();
         collectTypeChildren(reference.type(), reference.sourceClass());
       }
       while (!currentModuleReferences.symbolsToResolve.isEmpty()) {
+        if (!beginGraphExpansion()) {
+          return;
+        }
         SymbolReference reference = currentModuleReferences.symbolsToResolve.pop();
         collectSymbolChildren(reference.symbol(), reference.sourceClass());
       }
     }
+  }
+
+  private boolean beginGraphExpansion() {
+    if (currentModuleReferences.graphExpansions >= graphExpansionLimit) {
+      currentModuleReferences.graphTraversalComplete = false;
+      currentModuleReferences.typesToResolve.clear();
+      currentModuleReferences.symbolsToResolve.clear();
+      currentModuleReferences.symbolSources.clear();
+      currentModuleReferences.typeSources.clear();
+      currentModuleReferences.typeArgumentSources.clear();
+      return false;
+    }
+    currentModuleReferences.graphExpansions++;
+    return true;
   }

