+  @Test
+  void bounds_graph_expansion_without_truncating_identifier_measurements() throws IOException {
+    SemanticReportScanner scanner = new SemanticReportScanner(3);
+    Symbol.TypeSymbol source = typeSymbol("example.Source", "example", "Source");
+    List<Symbol.TypeSymbol> nodes = java.util.stream.IntStream.range(0, 6)
+      .mapToObj(i -> typeSymbol("library.Node" + i, "library", "Node" + i)).toList();
+    for (int i = 0; i < nodes.size(); i++) {
+      when(nodes.get(i).isPublic()).thenReturn(true);
+      when(nodes.get(i).memberSymbols()).thenReturn(i + 1 < nodes.size() ? List.of(nodes.get(i + 1)) : List.of());
+    }
+    scanner.enterModule(temp);
+    IdentifierTree first = mock(IdentifierTree.class);
+    when(first.name()).thenReturn("Node0");
+    when(first.symbol()).thenReturn(nodes.getFirst());
+    scanIdentifier(scanner, source, first);
+
+    Symbol.TypeSymbol later = typeSymbol("library.Later", "library", "Later");
+    IdentifierTree second = mock(IdentifierTree.class);
+    when(second.name()).thenReturn("Later");
+    when(second.symbol()).thenReturn(later);
+    scanIdentifier(scanner, source, second);
+    IdentifierTree missing = mock(IdentifierTree.class);
+    when(missing.name()).thenReturn("Missing");
+    when(missing.symbol()).thenReturn(Symbol.UNKNOWN_SYMBOL);
+    scanIdentifier(scanner, source, missing);
+    scanner.leaveModule();
+
+    Path report = temp.resolve("bounded-report.json");
+    scanner.writeReport(report, temp);
+    var result = JsonParser.parseString(Files.readString(report)).getAsJsonObject();
+    var module = result.getAsJsonArray("modules").get(0).getAsJsonObject();
+    assertThat(result.get("resolvedIdentifierCount").getAsInt()).isEqualTo(2);
+    assertThat(result.get("unknownIdentifierCount").getAsInt()).isEqualTo(1);
+    assertThat(result.get("graphTraversalComplete").getAsBoolean()).isFalse();
+    assertThat(result.get("graphExpansionLimit").getAsInt()).isEqualTo(3);
+    assertThat(result.get("graphExpansions").getAsInt()).isEqualTo(3);
+    assertThat(module.get("graphTraversalComplete").getAsBoolean()).isFalse();
+    assertThat(module.get("graphExpansions").getAsInt()).isEqualTo(3);
+    assertThat(module.getAsJsonArray("files")).hasSize(3);
+    assertThat(java.util.stream.StreamSupport.stream(module.getAsJsonArray("files").spliterator(), false)
+      .mapToInt(file -> file.getAsJsonObject().get("numberOfIdentifier").getAsInt()).sum()).isEqualTo(3);
+    verify(nodes.get(3), never()).memberSymbols();
+    verify(later, never()).memberSymbols();
+    verify(later, never()).type();
+  }
+
+  @Test
+  void disables_graph_queries_while_preserving_all_identifiers() throws IOException {
+    SemanticReportScanner scanner = new SemanticReportScanner(0);
+    Symbol.TypeSymbol source = typeSymbol("example.Source", "example", "Source");
+    Symbol known = mock(Symbol.class);
+    IdentifierTree identifier = mock(IdentifierTree.class);
+    when(identifier.name()).thenReturn("Known");
+    when(identifier.symbol()).thenReturn(known);
+    IdentifierTree missing = mock(IdentifierTree.class);
+    when(missing.name()).thenReturn("Missing");
+    when(missing.symbol()).thenReturn(Symbol.UNKNOWN_SYMBOL);
+    scanner.enterModule(temp);
+    scanIdentifier(scanner, source, identifier);
+    scanIdentifier(scanner, source, missing);
+    scanner.leaveModule();
+
+    Path report = temp.resolve("identifiers-only-report.json");
+    scanner.writeReport(report, temp);
+    var result = JsonParser.parseString(Files.readString(report)).getAsJsonObject();
+    var module = result.getAsJsonArray("modules").get(0).getAsJsonObject();
+    assertThat(result.get("resolvedIdentifierCount").getAsInt()).isEqualTo(1);
+    assertThat(result.get("unknownIdentifierCount").getAsInt()).isEqualTo(1);
+    assertThat(result.get("graphTraversalComplete").getAsBoolean()).isFalse();
+    assertThat(result.get("graphExpansionLimit").getAsInt()).isZero();
+    assertThat(result.get("graphExpansions").getAsInt()).isZero();
+    for (String field : List.of("resolvedSymbolCount", "unknownSymbolCount", "resolvedTypeCount", "unknownTypeCount")) {
+      assertThat(result.get(field).getAsInt()).isZero();
+    }
+    assertThat(module.getAsJsonArray("files")).hasSize(2);
+    assertThat(module.getAsJsonArray("unknownSymbols")).isEmpty();
+    assertThat(module.getAsJsonArray("unknownTypes")).isEmpty();
+    verify(known, never()).type();
+    verify(known, never()).owner();
+    verify(known, never()).enclosingClass();
+  }
