<develocity>
  <server>
    <url>https://develocity.sonar.build</url>
  </server>
  <buildScan>
    <publishing>
      <onlyIf><![CDATA[env['CI'] != null]]></onlyIf>
    </publishing>
  </buildScan>
  <buildCache>
    <local>
      <storeEnabled>#{env['CI'] == null}</storeEnabled>
    </local>
    <remote>
      <storeEnabled>#{env['CI'] != null}</storeEnabled>
    </remote>
  </buildCache>
</develocity>
